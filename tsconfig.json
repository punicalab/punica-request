{
  "compilerOptions": {
    "lib": ["es2018", "DOM", "DOM.Iterable"],
    "module": "commonjs",
    "target": "es2018",
    "moduleResolution": "node",
    "declaration": true,
    "sourceMap": false,
    "declarationMap": false,
    "removeComments": false,
    "strict": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node", "jest"]
  },
  "exclude": ["**/node_modules", "**/dist", "**/bundled"]
}
