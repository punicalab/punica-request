{
  "name": "@punica/request-middleware",
  "version": "2.6.5",
  "description": "Request Middleware",
  "keywords": [
    "http",
    "promise",
    "reflect",
    "ajax",
    "fetch",
    "middleware"
  ],
  "homepage": "https://request.punicalab.com",
  "license": "ISC",
  "author": {
    "name": "Uryan Sezgin TEKE",
    "email": "uryan.sezgin.teke@gmail.com",
    "url": "https://github.com/punicalab"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/punicalab/punica-request.git",
    "directory": "packages/middleware"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup lib/index.ts --format esm,cjs --target es2018 --clean && tsc -p tsconfig.build.json --emitDeclarationOnly",
    "clean": "rimraf dist",
    "lint": "eslint lib"
  },
  "dependencies": {
    "@punica/request": "workspace:^"
  }
}
