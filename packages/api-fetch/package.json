{
  "name": "@punica/request-fetch",
  "version": "3.2.2",
  "description": "Request Fetch",
  "keywords": [
    "http",
    "promise",
    "reflect",
    "ajax",
    "fetch"
  ],
  "homepage": "https://request.punicalab.com",
  "license": "MIT",
  "author": {
    "name": "Uryan Sezgin TEKE",
    "email": "uryan.sezgin.teke@gmail.com",
    "url": "https://github.com/punicalab"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/punicalab/punica-request.git",
    "directory": "packages/api-fetch"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup lib/index.ts --format esm,cjs --target es2018 --clean && tsc -p tsconfig.build.json --emitDeclarationOnly",
    "clean": "rimraf dist",
    "lint": "eslint lib",
    "test": "node --test test/*.test.mjs"
  },
  "peerDependencies": {
    "@punica/request": "workspace:^"
  },
  "devDependencies": {
    "@punica/request": "workspace:^"
  }
}
